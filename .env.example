# LedgerFlow Environment Variables

# App URL & Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database Configuration (PostgreSQL in Production, SQLite for Local Demo)
DATABASE_URL="file:./prisma/dev.db"
# Production Example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/ledgerflow?schema=public"

# Auth Session Secret
NEXTAUTH_SECRET="ledgerflow_super_secure_session_secret_min_32_chars"
NEXTAUTH_URL="http://localhost:3000"

# S3-Compatible Private File Storage (AWS S3, Cloudflare R2, MinIO)
S3_BUCKET_NAME="ledgerflow-private-documents"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
S3_ENDPOINT="" # Optional custom endpoint for MinIO/R2

# Email Provider Abstraction (Resend / SendGrid / SMTP)
# If left empty, LedgerFlow stores messages as in-app only and labels: "In-app only — email not configured"
RESEND_API_KEY=""
FROM_EMAIL="notifications@ledgerflow.io"

# Stripe Payment Gateway (Optional, for client invoice payments)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
